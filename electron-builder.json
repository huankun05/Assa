{
  "appId": "com.assa.app",
  "productName": "Assa",
  "copyright": "© 2026 Assa",
  "directories": {
    "buildResources": "resources",
    "output": "dist"
  },
  "files": [
    "out/**/*",
    "!out/renderer/.vite/**"
  ],
  "asarUnpack": [
    "node_modules/@assa/**/src/bin/Release/**/*",
    "node_modules/@assa/**/*.node",
    "node_modules/koffi/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/icon",
      "to": "icon",
      "filter": ["**/*"]
    },
    {
      "from": "resources/settings-loading.html",
      "to": "settings-loading.html"
    },
    {
      "from": "resources/capture.html",
      "to": "capture.html"
    },
    {
      "from": "resources/capture.css",
      "to": "capture.css"
    },
    {
      "from": "resources/capture.js",
      "to": "capture.js"
    },
    {
      "from": "resources/pin.html",
      "to": "pin.html"
    },
    {
      "from": "resources/pin.css",
      "to": "pin.css"
    },
    {
      "from": "resources/pin.js",
      "to": "pin.js"
    },
    {
      "from": "resources/qishui-auth-v6.js",
      "to": "qishui-auth-v6.js"
    },
    {
      "from": "resources/qishui-qr-login.js",
      "to": "qishui-qr-login.js"
    },
    {
      "from": "resources/qishui-auth-v6",
      "to": "qishui-auth-v6",
      "filter": ["**/*"]
    },
    {
      "from": "resources/svg",
      "to": "svg",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/@assa/windows-brightness-helper/src/bin/Release/net10.0/win-x64",
      "to": "helpers/brightness",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/@assa/windows-volume-helper/src/bin/Release/net10.0/win-x64",
      "to": "helpers/volume",
      "filter": ["**/*"]
    },
    {
      "from": "resources/netease-watcher",
      "to": "helpers/netease-watcher",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/ffmpeg-static/ffmpeg.exe",
      "to": "ffmpeg/ffmpeg.exe"
    }
  ],
  "win": {
    "icon": "resources/icon/assa_256x256.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "deleteAppDataOnUninstall": false,
    "include": "installer.nsh"
  },
  "publish": {
    "provider": "generic",
    "url": "https://pub-4c1e73c3c2004901aecd6ca014cb16bd.r2.dev"
  }
}
